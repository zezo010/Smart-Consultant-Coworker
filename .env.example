# HexaGen GRC Configuration

# Server Settings
HOST=0.0.0.0
PORT=7010
LOG_LEVEL=INFO

# Ollama Settings (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct-q4_K_M
# Alternative models: llama2:7b, llama2:13b, codellama:7b

# Embeddings Settings (Local)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# Alternative: BAAI/bge-m3, intfloat/multilingual-e5-large

# Vector Database Settings
CHROMA_PERSIST_DIR=./data/kb/vectordb
CHROMA_HOST=localhost
CHROMA_PORT=8000
USE_LOCAL_CHROMA=true

# Knowledge Base Settings
KB_STAGING_DIR=./data/kb/staging
KB_PROCESSED_DIR=./data/kb/processed
KB_CHUNK_SIZE=512
KB_CHUNK_OVERLAP=50

# Templates Settings
TEMPLATES_DIR=./templates
FRAMEWORKS_DIR=./frameworks

# Client Data Settings
CLIENTS_DATA_DIR=./data/clients

# Agent Settings
MAX_AGENT_ITERATIONS=5
AGENT_TEMPERATURE=0.3
AGENT_MAX_TOKENS=2048

# Document Generation Settings
DEFAULT_LANGUAGE=ar
SUPPORTED_LANGUAGES=ar,en
OUTPUT_FORMAT=docx

# RAG Settings
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.7

# Rate Limiting
RATE_LIMIT_ENABLED=false
MAX_REQUESTS_PER_MINUTE=60

# Security
API_KEY_ENABLED=false
API_KEY=your-secret-key-here

# Development
DEBUG=false
RELOAD=true
